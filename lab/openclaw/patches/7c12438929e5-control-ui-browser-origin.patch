+  test("persists the verified Control UI Origin on pairing and reconnects after approval", async () => {
+    const origin = "https://control-ui.example.test";
+    const auth = { mode: "token", token: "control-ui-browser-origin-token" } as const;
+    const scopes = ["operator.read", "operator.write"];
+    testState.gatewayAuth = auth;
+    testState.gatewayControlUi = { allowedOrigins: [origin] };
+    await replaceConfigFile({
+      nextConfig: {
+        gateway: {
+          auth,
+          controlUi: { allowedOrigins: [origin] },
+          nodes: { pairing: { autoApproveLocal: false } },
+        },
+      },
+      afterWrite: { mode: "auto" },
+    });
+    const started = await startServerWithClient(undefined, {
+      auth,
+      controlUiEnabled: true,
+      wsHeaders: { origin },
+    });
+    const loaded = loadDeviceIdentity("control-ui-browser-origin");
+    let reconnect: Awaited<ReturnType<typeof openTrackedWs>> | undefined;
+    try {
+      const first = await connectReq(started.ws, {
+        client: CONTROL_UI_CLIENT,
+        token: auth.token,
+        scopes,
+        deviceIdentityPath: loaded.identityPath,
+        prePairDevice: false,
+      });
+      expect(first.ok).toBe(false);
+      const pending = (await listDevicePairing()).pending.find(
+        (entry) => entry.deviceId === loaded.identity.deviceId,
+      );
+      expect(pending).toMatchObject({
+        browserOrigin: origin,
+        clientId: CONTROL_UI_CLIENT.id,
+        role: "operator",
+      });
+      if (!pending) {
+        throw new Error("expected a pending Control UI pairing request");
+      }
+      const approved = await pairingApprovals.approveDevicePairing(pending.requestId, {
+        callerScopes: ["operator.admin"],
+      });
+      expect(approved.status).toBe("approved");
+
+      reconnect = await openTrackedWs(started.port, { origin });
+      const connected = await connectReq(reconnect, {
+        client: CONTROL_UI_CLIENT,
+        token: auth.token,
+        scopes,
+        deviceIdentityPath: loaded.identityPath,
+        prePairDevice: false,
+      });
+      expect(connected.ok, JSON.stringify(connected)).toBe(true);
+      expect(
+        (await listDevicePairing()).pending.map((entry) => entry.deviceId),
+      ).not.toContain(loaded.identity.deviceId);
+    } finally {
+      reconnect?.close();
+      started.ws.close();
+      await started.server.close();
+      started.envSnapshot.restore();
+    }
+  });
+
