server {
    listen 172.24.3.1:11434;
    server_name _;
    access_log off;
    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://127.0.0.1:11434;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:11434;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
    location / { return 404; }
}
