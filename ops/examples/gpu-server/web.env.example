# EXAMPLE ONLY. Generate a new WEBUI_SECRET_KEY using scripts/init_env.py.
# Never put a real key into this example or commit an actual .env file.
WEBUI_SECRET_KEY=
WEB_PORT=3000
AGENT_PLATFORM_PUBLIC_ORIGIN=https://bezr.space
AGENT_CONTROL_UI_DOMAIN=agents.bezr.space
# Verify the actual Compose network gateway; never trust * or a whole CIDR.
FORWARDED_ALLOW_IPS=172.18.0.1
WEB_MEMORY_LIMIT=2g
WEB_CPU_LIMIT=2.0
