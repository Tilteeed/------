# Copying this example is NOT sufficient: generate a random WEBUI_SECRET_KEY
# with `python scripts/init_env.py` on the VM. Never commit the real .env.
# Per-machine values, not universal lab defaults. See docs/DEPLOYMENT_CONFIG.md.
# Storage UUID/mount configuration is not implemented by this web-only .env.
WEBUI_SECRET_KEY=
WEB_PORT=3000
AGENT_PLATFORM_PUBLIC_ORIGIN=http://localhost:3000
# Set only after wildcard DNS/TLS and the owner-scoped Access Proxy are deployed.
AGENT_CONTROL_UI_DOMAIN=
# Web-only default. For host Nginx, replace with its exact Docker bridge peer IP
# (normally the live `web` network gateway), optionally plus other exact trusted IPs.
# Never use `*` or CIDR ranges; Supervisor fails closed if the bridge gateway is missing.
FORWARDED_ALLOW_IPS=127.0.0.1
# Initial web-only limits; adjust to the actual VM after measurement.
WEB_MEMORY_LIMIT=2g
WEB_CPU_LIMIT=2.0
